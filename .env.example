# Empty on GitHub Pages (dummy data only). Local/production Docker sets the API.
NEXT_PUBLIC_API_URL=

# Dummy landing data for GitHub. Production Docker sets this to false.
NEXT_PUBLIC_USE_DEMO_DATA=true

NEXT_PUBLIC_TELEGRAM_BOT=pro_design_perfect_bot
NEXT_PUBLIC_DASHBOARD_URL=http://127.0.0.1:5173/dashboard
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://www.facebook.com/profile.php?id=61584616932975
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/homeofcreativity.sy/
NEXT_PUBLIC_SITE_URL=https://hoc.agency
# Google Search Console HTML tag token (required when NEXT_PUBLIC_USE_DEMO_DATA=false)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Maps Embed (Maps Embed API). Also reads GOOGLE_API_KEY if set.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
